# EditorConfig keeps whitespace consistent across editors before any formatter
# runs, so a contributor without Ruff installed still cannot introduce churn.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[Justfile]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
